{
  "name": "tanstack-router-rest-search-serializer",
  "version": "0.2.3",
  "description": "REST API compliant search param serializer for TanStack Router",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./zod-helpers": {
      "import": {
        "types": "./dist/zod-helpers/index.d.ts",
        "default": "./dist/zod-helpers/index.js"
      },
      "require": {
        "types": "./dist/zod-helpers/index.d.cts",
        "default": "./dist/zod-helpers/index.cjs"
      }
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "test": "vitest",
    "test:run": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix",
    "format": "prettier --write src",
    "format:check": "prettier --check src",
    "spell": "cspell src/**/*.ts README.md",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "tanstack-router",
    "search-params",
    "serializer",
    "rest-api",
    "url-search-params"
  ],
  "author": "usapopo",
  "license": "MIT",
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/usapopopooon/tanstack-router-rest-search-param-serializer.git"
  },
  "bugs": {
    "url": "https://github.com/usapopopooon/tanstack-router-rest-search-param-serializer/issues"
  },
  "homepage": "https://github.com/usapopopooon/tanstack-router-rest-search-param-serializer",
  "peerDependencies": {
    "zod": "^3.0.0"
  },
  "peerDependenciesMeta": {
    "zod": {
      "optional": true
    }
  },
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@tanstack/react-router": "^1.120.5",
    "cspell": "^9.4.0",
    "eslint": "^9.39.2",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.7.4",
    "tsup": "^8.0.0",
    "typescript": "^5.0.0",
    "typescript-eslint": "^8.51.0",
    "vitest": "^2.0.0",
    "zod": "^3.0.0"
  }
}
